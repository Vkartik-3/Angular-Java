# Copy to secrets.yaml and fill in your own credentials; secrets.yaml is ignored.
apiVersion: v1
kind: Secret
metadata:
  name: groove-secrets
  namespace: groove
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: ""
  MONGO_USER: product
  MONGO_PASSWORD: ""
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: ""
  GRAFANA_ADMIN_PASSWORD: ""
